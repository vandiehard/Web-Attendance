NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://attendance:attendance@localhost:3306/attendance
SHADOW_DATABASE_URL=mysql://attendance:attendance@localhost:3306/attendance
APP_BASE_URL=http://localhost:5173
API_BASE_URL=/api/v1
SESSION_TTL_DAYS=7
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/evidence
STORAGE_ENDPOINT=
STORAGE_BUCKET=attendance
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
LOCATION_POLICY=NEEDS_REVIEW
LOCATION_MAX_ACCURACY_METERS=100
LATE_POLICY=ACCEPT_AS_LATE
